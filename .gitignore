# Publishing — credentials only.
# publishing/*.md is source content and IS tracked.
# Upload artefacts land under build/, already excluded above.
# The icon belongs in src/main/resources/icon.png and MUST be tracked: it ships inside the jar.
.env
*.env
secrets.properties
publishing/tokens*
publishing/*.local.*
*.token
*.pat

# Author identity remap (local only).
# .mailmap has to spell out the superseded addresses to match on them, so it must
# never be tracked. It is read from the working tree whether committed or not.
.mailmap
